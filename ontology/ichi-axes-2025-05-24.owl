        <schema:exclusion xml:lang="en">Family and partner violence behaviours</schema:exclusion>
        <schema:inclusion>Sexual violence towards someone who is not a partner or family member</schema:inclusion>
        <skos:definition xml:lang="en">Behaviour relating to the intentional use of physical force or power, threatened or actual, against another person, or against a group,  between individuals who are unrelated, and who may or may not know each other</skos:definition>

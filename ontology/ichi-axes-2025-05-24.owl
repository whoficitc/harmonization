    <!-- http://id.who.int/icd/entity/450631972 -->

    <Class rdf:about="http://id.who.int/icd/entity/450631972">
        <rdfs:subClassOf rdf:resource="http://id.who.int/icd/entity/1521256427"/>
        <schema:browserUrl rdf:resource="https://icd.who.int/dev11/f/en#/http%3A%2F%2Fid.who.int%2Ficd%2Fentity%2F450631972"/>
        <schema:exclusion>Ultrasound, per orifice</schema:exclusion>
        <skos:definition xml:lang="en">A subfield of acoustics dealing in the radio frequency range higher than acoustic sound waves (approximately above 20 kilohertz). Ultrasonic radiation is used therapeutically (diathermy and ultrasonic therapy) to generate heat and to selectively destroy tissues. It is also used in diagnostics, for example, ultrasonography and doppler ultrasound ; echoencephalography; and echocardiography, to visually display echoes received from irradiated tissues. (Def.: MeSH)</skos:definition>
        <skos:prefLabel xml:lang="en">Ultrasound, not otherwise specified</skos:prefLabel>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://id.who.int/icd/entity/450631972"/>
        <annotatedProperty rdf:resource="http://id.who.int/icd/schema/exclusion"/>
        <annotatedTarget>Ultrasound, per orifice</annotatedTarget>
        <schema:foundationReference rdf:resource="http://id.who.int/icd/entity/789307162"/>
